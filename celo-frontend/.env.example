# Copy this to .env.local and fill in your values — never commit .env.local

# Privy (wallet auth)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# NOTE: use NEXT_PUBLIC_SUPABASE_ANON_KEY — not NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

# Celo RPC (optional — defaults to https://forno.celo.org)
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org

# MetaMap KYC
NEXT_PUBLIC_METAMAP_CLIENT_ID=your_metamap_client_id
NEXT_PUBLIC_METAMAP_FLOW_ID=your_metamap_flow_id

# AI Chat (Gemini — server-side only, never expose to client)
GEMINI_API_KEY=your_gemini_api_key
